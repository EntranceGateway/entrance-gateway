# Student portal. Copy to .env.local for Next.js, or .env for Compose substitution.
# Replace example hosts. Never put credentials in NEXT_PUBLIC_* variables.
# For local backend development, use http://localhost:8080 for both API origins.

# Public build-time backend origin: omit /api/v1 and any trailing slash.
# Set before pnpm build, or pass --build-arg NEXT_PUBLIC_API_URL to docker build.
# Rebuild the image when any NEXT_PUBLIC_* value changes.
NEXT_PUBLIC_API_URL=https://api.example.com

# Server-only runtime backend origin, reachable from the Next.js container.
# May be a private backend origin when both services share a Docker network.
INTERNAL_API_URL=https://api.example.com

# Browser-accessible chatbot endpoint, including /api/v1; requires chatbot CORS.
# Docker build arg: NEXT_PUBLIC_CHATBOT_API_BASE_URL.
NEXT_PUBLIC_CHATBOT_API_BASE_URL=https://chat.example.com/api/v1
# Optional streaming; false is the current default. Read at Next.js build time.
# Current Dockerfile has no build arg for this switch; it defaults to false.
NEXT_PUBLIC_CHATBOT_STREAMING_ENABLED=false

# docker-compose.yml uses a prebuilt image: build/push these public URLs into it.
# These select the image and host port; they are not application credentials.
REGISTRY=docker.io
IMAGE_NAME=your-account/entrance-gateway-frontend
IMAGE_TAG=latest
APP_PORT=5000

# NODE_ENV, PORT=5000 and HOSTNAME=0.0.0.0 are already set by the Dockerfile.
# Next.js sets NODE_ENV for dev/build/start; do not override it in .env.local.
